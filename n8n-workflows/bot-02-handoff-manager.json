{
  "name": "BOT-02 Handoff Manager",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "chat/handoff",
        "responseMode": "responseNode"
      },
      "id": "b084094d-e587-4616-ad64-4d0afb49cdf8",
      "name": "Handoff Webhook Ingest",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const body = $json.body || $json;\n\nconst sessionId = body.sessionId || body.session_id || ('sess_' + Date.now());\nconst contactEmail = body.contactEmail || body.email || body.senderEmail || 'Not provided';\nconst contactName = body.contactName || body.name || body.senderName || 'Visitor';\nconst reason = body.reason || body.intent || 'Human assistance requested';\nconst source = body.source || (body.conversationId ? 'chatwoot' : 'typebot');\nconst userNotes = body.message || body.notes || '';\n\nreturn [{\n  json: {\n    sessionId,\n    contactEmail,\n    contactName,\n    reason,\n    source,\n    userNotes,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "209b4d14-55c9-4f4a-a15b-05ff8f9b1ea7",
      "name": "Normalize Handoff Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        340,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.LINK_TO_YOUR_SUPABASE_URL }}/rest/v1/chat_messages",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "session_id",
              "value": "eq.{{ $json.sessionId }}"
            },
            {
              "name": "order",
              "value": "created_at.desc"
            },
            {
              "name": "limit",
              "value": "10"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            }
          ]
        }
      },
      "id": "9c7e1157-6380-4abd-82d6-ab143595ab83",
      "name": "Fetch Session Context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        580,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.OPENAI_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"gpt-4o-mini\",\n  messages: [\n    {\n      role: \"system\",\n      content: \"Summarize this customer support chat in 2 concise sentences. Highlight the core customer question and the reason for escalation.\"\n    },\n    {\n      role: \"user\",\n      content: JSON.stringify($json)\n    }\n  ]\n}) }}"
      },
      "id": "e3c6d28b-cda5-4a0e-a1ad-0f7c53fd4c77",
      "name": "Synthesize Context Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        820,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LINK_TO_YOUR_SUPABASE_URL }}/rest/v1/handoffs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  session_id: $('Normalize Handoff Data').first().json.sessionId,\n  contact_email: $('Normalize Handoff Data').first().json.contactEmail,\n  reason: $('Normalize Handoff Data').first().json.reason,\n  summary: $json.choices[0].message.content,\n  status: 'open'\n}) }}"
      },
      "id": "fcc40752-207a-48d6-8c6f-cfe12ae399a1",
      "name": "Create Handoff Record in Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1060,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.RESEND_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  from: $env.SYSTEM_SENDER_EMAIL || \"support-alerts@yourdomain.com\",\n  to: [$env.OWNER_NOTIFICATION_EMAIL],\n  subject: `[HANDOFF] Website Support Needed (${$('Normalize Handoff Data').first().json.source.toUpperCase()})`,\n  html: `<h3>New Customer Chat Escalation</h3>\n<p><strong>Channel / Origin:</strong> ${$('Normalize Handoff Data').first().json.source}</p>\n<p><strong>Customer Name:</strong> ${$('Normalize Handoff Data').first().json.contactName}</p>\n<p><strong>Customer Email:</strong> ${$('Normalize Handoff Data').first().json.contactEmail}</p>\n<p><strong>Escalation Reason:</strong> ${$('Normalize Handoff Data').first().json.reason}</p>\n<p><strong>Summary:</strong> ${$('Synthesize Context Summary').first().json.choices[0].message.content}</p>\n<p><a href=\"${$env.LINK_TO_YOUR_DASHBOARD || 'https://dashboard.yourdomain.com'}/inbox\">Open Inbox in Dashboard</a></p>`\n}) }}"
      },
      "id": "133478ad-16b5-4851-95fd-579f829d3e22",
      "name": "Alert Team via Resend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1300,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({\n  success: true,\n  status: \"escalated\",\n  message: \"Support handoff ticket created and team notified.\"\n}) }}"
      },
      "id": "27e3f306-3e18-4a92-94f2-c880d238096f",
      "name": "Respond Handoff Handled",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1540,
        300
      ]
    }
  ],
