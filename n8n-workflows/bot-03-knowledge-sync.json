      },
      "id": "abeffcda-a79b-45a7-98a1-6d5915b68e49",
      "name": "Fetch Content Sources",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        340,
        300
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const docs = Array.isArray($json) ? $json : [$json];\nconst chunks = [];\n\nfor (const doc of docs) {\n  const content = doc.content || doc.title || '';\n  const paragraphs = content.split(/\\n\\n+/);\n  \n  for (let i = 0; i < paragraphs.length; i++) {\n    const text = paragraphs[i].trim();\n    if (text.length > 30) {\n      chunks.push({\n        document_id: doc.id,\n        chunk_index: i,\n        content: text\n      });\n    }\n  }\n}\n\nreturn chunks.map(c => ({ json: c }));"
      },
      "id": "7c419c87-1f0c-4928-b449-5ababc8b3bfd",
      "name": "Chunk Documents",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        580,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/embeddings",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.OPENAI_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"text-embedding-3-small\",\n  input: $json.content\n}) }}"
      },
      "id": "e44051b3-a49c-460b-bc1c-7ed30f17f74c",
      "name": "Generate Chunk Embedding",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        820,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LINK_TO_YOUR_SUPABASE_URL }}/rest/v1/kb_chunks",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  document_id: $('Chunk Documents').first().json.document_id,\n  content: $('Chunk Documents').first().json.content,\n  embedding: $json.data[0].embedding\n}) }}"
      },
      "id": "f99060c8-9fa8-4dcc-9abd-e1c9dfa9edb4",
      "name": "Upsert kb_chunks",
