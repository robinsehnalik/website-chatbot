        "url": "={{ $env.SUPABASE_URL }}/rest/v1/kb_documents?select=*",
        "method": "GET",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
