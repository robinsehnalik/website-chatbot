      "id": "b7ad7f6e-f948-4f8d-b54e-8744b187c09b",
      "name": "Fetch Source Documents",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const doc = $input.item.json;\nconst content = doc.content || doc.title || '';\nconst docId = doc.id;\nconst sourceUrl = doc.source_url || '';\nconst title = doc.title || '';\n\n// Clean sliding window chunking (~400 characters per chunk, 50 char overlap)\nconst chunkSize = 400;\nconst overlap = 50;\nconst chunks = [];\n\nlet start = 0;\nwhile (start < content.length) {\n  const end = Math.min(start + chunkSize, content.length);\n  const chunkText = content.substring(start, end).trim();\n  \n  if (chunkText.length > 20) {\n    // Compute content hash\n    let hash = 0;\n    for (let i = 0; i < chunkText.length; i++) {\n      const char = chunkText.charCodeAt(i);\n      hash = ((hash << 5) - hash) + char;\n      hash = hash & hash;\n    }\n    const contentHash = 'hash_' + Math.abs(hash).toString(16) + '_' + chunkText.substring(0, 10).replace(/\\W/g, '');\n\n    chunks.push({\n      document_id: docId,\n      content: chunkText,\n      source_url: sourceUrl,\n      document_title: title,\n      content_hash: contentHash\n    });\n  }\n  start += (chunkSize - overlap);\n}\n\nreturn chunks.map(c => ({ json: c }));"
      },
      "id": "dfce7ad1-4f79-4355-9205-6424c5174f8a",
      "name": "Chunk & Compute Content Hash",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://api.openai.com/v1/embeddings",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.OPENAI_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"model\": \"text-embedding-3-small\",\n  \"input\": $json.content\n}"
      },
      "id": "02d31d90-22b5-4df6-bb81-56760be1b991",
      "name": "OpenAI: Generate Embedding",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        920,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/kb_chunks",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"document_id\": $('Chunk & Compute Content Hash').item.json.document_id,\n  \"content\": $('Chunk & Compute Content Hash').item.json.content,\n  \"source_url\": $('Chunk & Compute Content Hash').item.json.source_url,\n  \"content_hash\": $('Chunk & Compute Content Hash').item.json.content_hash,\n  \"embedding\": $json.data[0].embedding\n}"
      },
      "id": "e0f6b3a6-a8fb-4501-9156-80d300415b64",
      "name": "Supabase: Upsert Vector Chunk",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1160,
