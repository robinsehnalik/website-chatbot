            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify([\n  {\n    session_id: 'chatwoot_conv_' + $('Parse Chatwoot Event').first().json.conversationId,\n    role: \"visitor\",\n    content: $('Parse Chatwoot Event').first().json.content\n  },\n  {\n    session_id: 'chatwoot_conv_' + $('Parse Chatwoot Event').first().json.conversationId,\n    role: \"bot\",\n    content: $('LLM Grounded Answer').first().json.choices[0].message.content,\n    sources: $('Format Context & Check Grounding').first().json.chunkIds\n  }\n]) }}"
      },
      "id": "6b6ee32e-d41d-405e-8732-928d5e3c2f6f",
