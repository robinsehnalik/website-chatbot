{
  "name": "BOT-ERR Global Error Handler",
  "nodes": [
    {
      "parameters": {},
      "id": "e73640ac-422c-46e9-b090-5c379b6d7a2d",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const errorData = $input.item.json;\nconst execution = errorData.execution || {};\nconst workflow = errorData.workflow || {};\nconst error = errorData.execution?.error || {};\n\nreturn {\n  json: {\n    workflow_name: workflow.name || 'Chatbot Workflow',\n    node_name: error.node?.name || 'Unknown Node',\n    error_message: error.message || 'Unknown runtime error',\n    execution_id: execution.id || '',\n    occurred_at: new Date().toISOString()\n  }\n};"
      },
      "id": "4c2eedbb-5b60-461b-9af5-b2e27aaf550e",
      "name": "Format Error Incident",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://api.resend.com/emails",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.RESEND_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"from\": \"{{ $env.SYSTEM_SENDER_EMAIL }}\",\n  \"to\": [\"{{ $env.ADMIN_NOTIFICATION_EMAIL }}\"],\n  \"subject\": \"[CRITICAL] Chatbot Background Workflow Error: \" + $json.node_name,\n  \"html\": \"<h3>Chatbot Workflow Failure</h3>\" +\n          \"<p><strong>Workflow:</strong> \" + $json.workflow_name + \"</p>\" +\n          \"<p><strong>Node:</strong> \" + $json.node_name + \"</p>\" +\n          \"<p><strong>Error:</strong> \" + $json.error_message + \"</p>\" +\n          \"<p><strong>Execution ID:</strong> \" + $json.execution_id + \"</p>\"\n}"
      },
      "id": "80f1b9f5-48a2-4d64-b327-9fd0d1a2afca",
      "name": "Resend: Send Admin Error Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        720,
        300
      ]
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
