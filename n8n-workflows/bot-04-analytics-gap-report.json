        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"gpt-4o\",\n  messages: [\n    {\n      role: \"system\",\n      content: \"Analyze these customer support escalations. Group them into recurring unanswered topics and provide 3-5 concrete suggested FAQ entries with questions and answers.\"\n    },\n    { role: \"user\", content: JSON.stringify($json) }\n  ]\n}) }}"
      },
