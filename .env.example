# ==============================================================================
# Website AI Chatbot System — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Infrastructure
# ------------------------------------------------------------------------------
# Public URL of your Supabase instance
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Service Role Key (NEVER expose to client; used strictly by Edge Function & n8n)
SUPABASE_SERVICE_ROLE_KEY=eyJh...your-service-role-key

# ------------------------------------------------------------------------------
# 2. OpenAI API Configuration
# ------------------------------------------------------------------------------
# OpenAI API Key (requires access to text-embedding-3-small and gpt-4o-mini)
OPENAI_API_KEY=sk-proj-...your-openai-api-key

# Model selections
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# 3. Shared Security Secrets
# ------------------------------------------------------------------------------
# Shared secret for Edge Function authentication (Typebot -> rag-query Edge Function)
# Generate with: openssl rand -hex 24
RAG_SHARED_SECRET=replace_with_secure_random_rag_secret_key

# Shared secret for n8n Webhook authentication (Typebot -> n8n /chat/handoff)
# Generate with: openssl rand -hex 24
CHAT_WEBHOOK_SECRET=replace_with_secure_random_chat_webhook_secret

# ------------------------------------------------------------------------------
# 4. Email Alerting (Resend API)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_...your-resend-api-key
SYSTEM_SENDER_EMAIL=support-alerts@yourdomain.com
SUPPORT_ALERT_EMAIL=support-team@yourdomain.com
ADMIN_NOTIFICATION_EMAIL=engineering-alerts@yourdomain.com

# ------------------------------------------------------------------------------
# 5. RAG Engine & Safety Limits (Edge Function Config)
# ------------------------------------------------------------------------------
# Provisional vector cosine similarity threshold (tune using eval/ dataset)
MATCH_THRESHOLD=0.45

# Maximum number of knowledge chunks retrieved per query
MATCH_COUNT=4

# Maximum length (in characters) of the visitor question before truncation
MAX_QUERY_CHARS=500

# Number of past conversational turns used for question condensation
HISTORY_TURNS=3

# Rate limit: Maximum queries per session per hour
SESSION_RATE_LIMIT=20

# Daily cost cap: Maximum queries per day across all sessions
DAILY_QUERY_CAP=2000

# Maximum token budget for grounded completion
MAX_TOKENS=400

# Persist query analytics in rag_queries table (true/false)
LOG_QUERIES=true
