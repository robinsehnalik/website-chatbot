{
  "version": "6",
  "id": "website-ai-assistant",
  "name": "Website AI Assistant & Support Handoff",
  "events": [
    {
      "id": "start-event",
      "type": "start",
      "graphCoordinates": {
        "x": 0,
        "y": 0
      }
    }
  ],
  "groups": [
    {
      "id": "group-welcome",
      "title": "Welcome & Bot Disclosure",
      "graphCoordinates": {
        "x": 100,
        "y": 0
      },
      "blocks": [
        {
          "id": "block-disclosure",
          "type": "text",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  {
                    "text": "\ud83d\udc4b Hello! I am the AI Support Assistant. I can answer questions about shipping, returns, order policies, and products. If I cannot help, I will connect you directly with our team."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "block-user-query",
          "type": "text input",
          "options": {
            "labels": {
              "placeholder": "Ask a question..."
            },
            "variableId": "var-user-query"
          }
        }
      ]
    },
    {
      "id": "group-rag-query",
      "title": "Grounded Knowledge Query",
      "graphCoordinates": {
        "x": 450,
        "y": 0
      },
      "blocks": [
        {
          "id": "block-edge-fn",
          "type": "webhook",
          "options": {
            "url": "https://YOUR_SUPABASE_PROJECT.supabase.co/functions/v1/rag-query",
            "method": "POST",
            "headers": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer YOUR_SUPABASE_ANON_KEY"
              }
            ],
            "body": "{\n  \"query\": \"{{userQuery}}\",\n  \"sessionId\": \"{{sessionId}}\"\n}",
            "responseVariableMapping": [
              {
                "bodyPath": "answer",
                "variableId": "var-bot-answer"
              },
              {
                "bodyPath": "needs_human",
                "variableId": "var-needs-human"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "group-check-escalate",
      "title": "Evaluate Escalation",
      "graphCoordinates": {
        "x": 800,
        "y": 0
      },
      "blocks": [
        {
          "id": "block-condition",
          "type": "condition",
          "items": [
            {
              "id": "item-needs-human-true",
              "content": {
                "comparisons": [
                  {
                    "variableId": "var-needs-human",
                    "comparison": "equal",
                    "value": "true"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "group-bot-answer",
      "title": "Display Answer & Loop",
      "graphCoordinates": {
        "x": 1150,
        "y": -150
      },
      "blocks": [
        {
          "id": "block-answer-text",
          "type": "text",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  {
                    "text": "{{botAnswer}}"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "block-choices",
          "type": "choice input",
          "items": [
            {
              "id": "btn-more",
              "content": "Ask another question"
            },
            {
              "id": "btn-escalate",
              "content": "Speak with our team"
            }
          ]
        }
      ]
    },
    {
      "id": "group-handoff",
      "title": "Capture Contact & Escalate",
      "graphCoordinates": {
        "x": 1150,
        "y": 200
      },
      "blocks": [
        {
          "id": "block-handoff-intro",
          "type": "text",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  {
                    "text": "I will connect you with a team member. Please provide your email address so our team can follow up directly."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "block-get-email",
          "type": "email input",
          "options": {
            "labels": {
              "placeholder": "your.email@example.com"
            },
            "variableId": "var-contact-email"
          }
        },
        {
          "id": "block-get-name",
          "type": "text input",
          "options": {
            "labels": {
              "placeholder": "Your name"
            },
            "variableId": "var-contact-name"
          }
        },
        {
          "id": "block-webhook-handoff",
          "type": "webhook",
          "options": {
            "url": "https://n8n.yourdomain.com/webhook/chat/handoff",
            "method": "POST",
            "headers": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Webhook-Secret",
                "value": "YOUR_SHARED_WEBHOOK_SECRET"
              }
            ],
            "body": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"contactEmail\": \"{{contactEmail}}\",\n  \"contactName\": \"{{contactName}}\",\n  \"query\": \"{{userQuery}}\",\n  \"reason\": \"Visitor requested human support or low confidence\"\n}"
          }
        },
        {
          "id": "block-confirmation",
          "type": "text",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  {
                    "text": "Thank you, {{contactName}}! Our team has received your inquiry and will follow up at {{contactEmail}} shortly. For urgent inquiries, email support@company.com directly."
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": {
        "eventId": "start-event"
      },
      "to": {
        "groupId": "group-welcome"
      }
    },
    {
      "id": "e2",
      "from": {
        "groupId": "group-welcome",
        "blockId": "block-user-query"
      },
      "to": {
        "groupId": "group-rag-query"
      }
    },
    {
      "id": "e3",
      "from": {
        "groupId": "group-rag-query"
      },
      "to": {
        "groupId": "group-check-escalate"
      }
    },
    {
      "id": "e4",
      "from": {
        "groupId": "group-check-escalate",
        "blockId": "block-condition",
        "itemId": "item-needs-human-true"
      },
      "to": {
        "groupId": "group-handoff"
      }
    },
    {
      "id": "e5",
      "from": {
        "groupId": "group-check-escalate"
      },
      "to": {
        "groupId": "group-bot-answer"
      }
    },
    {
      "id": "e6",
      "from": {
        "groupId": "group-bot-answer",
        "blockId": "block-choices",
        "itemId": "btn-more"
      },
      "to": {
        "groupId": "group-welcome",
        "blockId": "block-user-query"
      }
    },
    {
      "id": "e7",
      "from": {
        "groupId": "group-bot-answer",
        "blockId": "block-choices",
        "itemId": "btn-escalate"
      },
      "to": {
        "groupId": "group-handoff"
      }
    }
  ],
  "variables": [
    {
      "id": "var-user-query",
      "name": "userQuery"
    },
    {
      "id": "var-bot-answer",
      "name": "botAnswer"
    },
    {
      "id": "var-needs-human",
      "name": "needsHuman"
    },
    {
      "id": "var-contact-email",
      "name": "contactEmail"
    },
    {
      "id": "var-contact-name",
      "name": "contactName"
    }
  ]
}